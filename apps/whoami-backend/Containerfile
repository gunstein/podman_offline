FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY Whoami.csproj .
COPY Checks/Checks.csproj Checks/
RUN dotnet restore Checks/Checks.csproj
COPY Program.cs Oidc.cs ./
COPY Checks/Program.cs Checks/
# The issuer-pin check fails the image build if it regresses.
RUN dotnet run --no-restore -c Release --project Checks
RUN dotnet publish Whoami.csproj --no-restore -c Release -o /out
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /out .
ENV ASPNETCORE_HTTP_PORTS=8000
ENTRYPOINT ["dotnet", "Whoami.dll"]
