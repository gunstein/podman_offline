# ./deploy install fills in the product name (bundles.yaml) and the unit name
# (<product>-<component>, or the product for a standalone fixture).
[Unit]
Description=@@UNIT_NAME@@

[Kube]
Yaml=@@UNIT_NAME@@.yaml
Network=@@PRODUCT_NAME@@.network

[Service]
Restart=on-failure
TimeoutStartSec=180

[Install]
WantedBy=default.target
