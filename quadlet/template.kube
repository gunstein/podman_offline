# ./deploy.sh install fills in the product name (bundles.yaml) and the unit name
# (<product>-<component>, or the product for a standalone fixture).
[Unit]
Description=@@UNIT_NAME@@

[Kube]
Yaml=@@UNIT_NAME@@.yaml
Network=@@PRODUCT_NAME@@.network
# Keep host /etc/hosts entries out of the containers: the public host name must
# resolve to the proxy in the product network, not to a host loopback line.
PodmanArgs=--no-hosts

[Service]
Restart=on-failure
TimeoutStartSec=180

[Install]
WantedBy=default.target
