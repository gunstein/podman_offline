# ./deploy.sh install fills in the product name (bundles.yaml) and the unit name
# (<product>-<component>, or the product for a standalone fixture).
[Unit]
Description=@@UNIT_NAME@@

[Kube]
Yaml=@@UNIT_NAME@@.yaml
Network=@@PRODUCT_NAME@@.network
[Service]
# Generate localhost entries without copying the host's /etc/hosts.
Environment="CONTAINERS_CONF_OVERRIDE=@@PODMAN_HOSTS_CONFIG@@"
Restart=on-failure
TimeoutStartSec=180

[Install]
WantedBy=default.target
