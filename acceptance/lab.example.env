# Copy outside Git to ~/.config/podman-offline-acceptance/lab.env; chmod 600.
# Values must describe two disposable, explicitly authorized lab VMs.
PVE_ENV=/home/USER/.config/todo-acceptance/pve.env
DEV_VMID=REQUIRED
DEV_IP=REQUIRED
DEV_SNAPSHOT=clean-agent
PROD_VMID=REQUIRED
PROD_IP=REQUIRED
PROD_SNAPSHOT=clean-agent
SSH_USER=REQUIRED
LAB_CIDR=REQUIRED
# Application DNS name, also resolved inside Podman; current product uses this name.
PROD_HOST=myproduct-proxy
HTTPS_PORT=8443
